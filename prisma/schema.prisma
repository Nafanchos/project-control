generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  DOCS
  PNR
  SMR
  OTHER
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  customers Customer[]
  projects  Project[]
  tasks     Task[]
  documents Document[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  mustChangePassword  Boolean  @default(false)
  role         UserRole @default(USER)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  tasks        Task[]

  @@index([tenantId])
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  inn       String?
  contact   String?
  createdAt DateTime  @default(now())
  projects  Project[]

  @@index([tenantId])
}

model Project {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@index([tenantId])
  @@index([customerId])
}

model Task {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  type       TaskType
  assigneeId String?
  assignee   User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  planStart  DateTime?
  planEnd    DateTime?
  factStart  DateTime?
  factEnd    DateTime?
  status     TaskStatus @default(PLANNED)
  createdAt  DateTime   @default(now())
  documents  Document[]

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
}

model Document {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  @@index([tenantId])
  @@index([taskId])
}